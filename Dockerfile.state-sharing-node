# Builds the state-sharing-node demo binary and runs it in a minimal image.
FROM golang:1.22 AS build

WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 go build -o /out/state-sharing-node ./cmd/state-sharing-node

FROM gcr.io/distroless/static-debian12

COPY --from=build /out/state-sharing-node /usr/local/bin/state-sharing-node

EXPOSE 8551

ENTRYPOINT ["/usr/local/bin/state-sharing-node"]
